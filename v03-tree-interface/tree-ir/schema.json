{"$schema":"http://json-schema.org/draft-07/schema#","description":"Canonical intermediate representation. Every producer emits it, every stage reads only it.","properties":{"ir_version":{"const":"0.3","type":"string"},"meta":{"properties":{"created":{"type":"string"},"niche":{"type":"string"},"source":{"enum":["grok-tree-generator","hand-built","importer"],"type":"string"}},"required":["source","niche"],"type":"object"},"nodes":{"items":{"properties":{"id":{"description":"Dotted path, e.g. website.home","type":"string"},"kind":{"enum":["business","system","page","channel","function","offer"],"type":"string"},"label":{"type":"string"},"note":{"description":"Xavier's tap annotation, optional","type":"string"},"order":{"description":"Order among siblings, optional","type":"integer"},"parent":{"description":"Parent node id; root's children use the root id","type":"string"}},"required":["id","parent","label","kind"],"type":"object"},"type":"array"},"root":{"properties":{"id":{"type":"string"},"kind":{"const":"business","type":"string"},"label":{"type":"string"}},"required":["id","label","kind"],"type":"object"},"tree_id":{"description":"Unique id, e.g. visibility-audit-001","type":"string"}},"required":["tree_id","ir_version","root","nodes","meta"],"title":"IMGCODE Tree IR v0.3","type":"object"}